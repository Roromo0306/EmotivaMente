  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Tienes que prepararte la comida y sabes que es importante comer platos
    saludables para nuestra salud y beber mucha agua. \n\nLa comida saludable incluye
    comer verduras, carne, pescado, frutas y comer muchos menos pasteles, refrescos
    con az\xFAcar, embutidos, pastas de pasteler\xEDa, tomar mucho az\xFAcar, entre
    otros\u201D. \n\nA continuaci\xF3n ir\xE1n saliendo platos de comida y deber\xE1s
    introducir en el plato de los saludables los que son buenos para tu salud y no
    deber\xE1s incluir los no saludables, es decir, los que perjudican tu salud y
    debes controlar"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
