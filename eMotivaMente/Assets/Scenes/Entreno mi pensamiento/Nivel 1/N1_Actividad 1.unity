  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Te vas de vacaciones y debes poner en tu maleta todas las cosas que necesitas
    para irte de viaje. Ver\xE1s que ir\xE1n apareciendo distintos objetos en la
    pantalla y con la mano los deber\xE1s arrastrar para meterlos en la maleta. \r\n\nEmpezamos
    a preparar la maleta para el viaje. Ir\xE1n saliendo diferentes objetos que deber\xE1s
    arrastrar con la mano para poner en la maleta pero debes recordar que hay tres
    objetos que no debes arrastrar a la maleta, estos objetos son, un coj\xEDn, una
    pelota y un paraguas grande. \n\nCuando aparezca alguno de estos tres objetos,
    recuerda que no debes hacer nada y as\xED desaparecer\xE1n. Tienes poco tiempo
    para meter las cosas en la maleta porque se te escapa el tren. Presta mucha atenci\xF3n
    y no te equivoques! \r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
