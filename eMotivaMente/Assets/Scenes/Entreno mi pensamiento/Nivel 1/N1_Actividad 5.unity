  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Ya estamos llegando al final del trayecto. En el \xFAltimo acceso nos
    encontramos un sem\xE1foro que es muy particular. Cada vez que aparezca un color
    (rojo, \xE1mbar o verde) tendremos que apretar una tecla concreta. Cuando se
    vea la luz roja se tocar\xE1 el tr\xE9bol, cuando se vea la luz verde el tomate,
    y cuando salga el color \xE1mbar, el bot\xF3n gris. Cuando se acierten todos
    llegar\xE1s al final del trayecto."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
