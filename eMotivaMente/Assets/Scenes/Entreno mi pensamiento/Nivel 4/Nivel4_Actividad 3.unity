  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Imagina que t\xFA eres el cajero de este supermercado. Tienes una cola
    de gente esperando. Observas que la gente se est\xE1 poniendo nerviosa y algunos
    se est\xE1n intentando colar. Debes poner orden. Vamos a poner orden: \r\n-Cuando
    veas que la persona que est\xE1 en la cola es amable y educada, d\xE9jala pasar
    apretando la flecha azul de la izquierda.\r\n-Cuando veas que la persona que
    est\xE1 en la cola es maleducada o se queja en exceso, ignorala y aprieta el
    ojo del medio. \r\n-Cuando veas que la persona que est\xE1 en la cola se intenta
    colar, no la dejes pasar y bloqueala apretando el signo prohibido de la derecha.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
