  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Vas caminando por la ciudad y tienes que llegar a casa de unos amigos,
    pero resulta que est\xE1s en un pa\xEDs que es un poco diferente, tendr\xE1s
    que ir siguiendo unas pistas un poco especiales. Tendr\xE1s que estar muy atento
    y hacer lo que se te dice, aunque sea lo contrario. Saldr\xE1n personas que van
    corriendo, caminando, que est\xE1n parados o que van despacio. Tienes que apretar
    en las im\xE1genes est\xE1ticas lo contrario de la persona que sale cada vez.\r\n-Cuando
    salga una persona CORRIENDO \u2192 apretar figura de PARADO\r\n-Cuando salga
    una persona PARADO  \u2192 apretar figura de CORRIENDO\r\n-Cuando salga una persona
    que va CAMINANDO a la derecha \u2192 apretar figura de CAMINANDO a la izquierda\r\n-Cuando
    salga una persona CAMINANDO a la izquierda \u2192 apretar figura de CAMINANDO
    a la derecha\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
