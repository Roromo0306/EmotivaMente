  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Eres trabajador de esta tienda de ropa y te han encargado vestir a estos
    maniqu\xEDs del escaparate. \n\nTus jefes son muy exigentes y lo quieren de una
    manera determinada, aquente dejan ponerle un toque personal, a tu gusto! \n\nLa
    consigna que te han dado tus jefes es clara, quieren que el maniqu\xED lleve
    puesto una parte de arriba roja y unos pantalones azules. Ahora, t\xFA decides
    qu\xE9 tipo de prenda pondr\xE1s mientras sea roja para la parte de arriba y
    azul para la parte de abajo. Si te salen complementos u otras cosas, no debes
    hacer nada, est\xE1n ah\xED para distraerte. "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
